# Supabase (público — pode ir para o client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredos — SOMENTE no servidor. Nunca commitar, nunca expor ao client.
# Preencher manualmente na Vercel (Environment Variables).
SUPABASE_SERVICE_ROLE_KEY=          # painel Supabase -> Settings -> API -> service_role
TELEGRAM_BOT_TOKEN=                 # criar bot no @BotFather

# Segredo do agendamento (resumo diário). Gere um texto aleatório qualquer;
# a Vercel o envia no cabeçalho ao disparar o cron.
CRON_SECRET=

# Login (usuário + senha). Defina as duas para ATIVAR o login e criar a conta
# mestra (administrador) no primeiro acesso. Em branco = app aberto, sem login.
ADMIN_USUARIO=                      # ex.: pedro
ADMIN_SENHA=                        # sua senha-mestra

# Opcional: segredo para assinar a sessão. Se em branco, usa o service role.
SESSION_SECRET=
