# Supabase (público — pode ir para o client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredos — SOMENTE no servidor. Nunca commitar, nunca expor ao client.
# Preencher manualmente na Vercel (Environment Variables).
SUPABASE_SERVICE_ROLE_KEY=          # painel Supabase -> Settings -> API -> service_role
TELEGRAM_BOT_TOKEN=                 # criar bot no @BotFather

# Login por senha (opcional). Se definida, o app exige essa senha para entrar.
# Se ficar em branco, o app fica aberto (sem login).
APP_SENHA=
